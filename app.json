{
  "expo": {
    "name": "Padelna",
    "slug": "padelna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "padelna",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.padelna.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.padelna.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#2D63C8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2D63C8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Padelna uses your photos so you can add a profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.933365905057-44pci2o6njimk2r37oa18lm51c0o8ipv"
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Padelna uses your location to show how far each club is from you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2D63C8"
        }
      ],
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Padelna adds your padel matches to your calendar when you ask it to."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Padelna saves your profile card or tournament result to your photos when you ask it to.",
          "photosPermission": false,
          "granularPermissions": ["photo"]
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7b1945f1-d14b-4f7f-bc3a-328edcf99924"
      }
    },
    "owner": "adamdey"
  }
}
