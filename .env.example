# Copy to .env.local. Both values are safe to ship in the app (the publishable key is limited by RLS).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Google sign-in client IDs from Google Cloud (OAuth client IDs; public, the secret stays in Supabase)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<number>-<web>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<number>-<ios>.apps.googleusercontent.com
